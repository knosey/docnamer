#!/bin/sh
# Every check this tree can run on a change, scoped to the change itself. The
# format pass rewrites the staged files and re-stages them, so what lands is
# what was checked; the analysis gate judges only what this commit touches and
# inherits what the tree already carried, so an old finding is never charged to
# an unrelated change. `bun check` is the typecheck: bun 1.4 resolves
# tsconfig.json and reports the whole tree's errors in one pass.
#
# `bun run test:free` is the files that make no paid model call. It is the test
# gate: a commit hook runs on every commit and on a machine with no network, so a
# suite that reached the model API from here would bill per commit and fail on a
# plane. tests/build.test.ts is deliberately absent — it makes a real call and is
# run by `bun run test:e2e`.
#
# A deletion changes the tree as much as an addition does, so the gates run for it
# too; only an added, renamed or modified file has anything to format.
set -e

touched=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -n "$touched" ] || exit 0

changed=$(git diff --cached --name-only --diff-filter=ACMR)

targets=""
for file in $changed; do
  case "$file" in
    *.ts | *.json) targets="$targets $file" ;;
  esac
done
if [ -n "$targets" ]; then
  bun fmt --no-script $targets
  for file in $targets; do
    git add -- "$file"
  done
fi

bun check
bunx oxlint --deny-warnings
bun run test:free
bun run audit
