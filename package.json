{
  "name": "docnamer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --path-ignore-patterns='**/*.red.spec.ts'",
    "test:e2e": "bun test",
    "build": "bun scripts/build-app.ts",
    "check": "bun check",
    "lint": "oxlint",
    "format": "oxfmt",
    "audit": "fallow audit --base HEAD",
    "prepare": "git config core.hooksPath .githooks",
    "install": "bun run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "mac-ocr": "^1.2.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "fallow": "^3.34.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0"
  }
}
